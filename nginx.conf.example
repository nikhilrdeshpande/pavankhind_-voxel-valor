# Nginx site config for pavankhind.bobhata.com
# The app is fully self-contained (no CDN scripts, no external fonts),
# so the CSP below allows only same-origin resources.
#
# 'unsafe-inline' in style-src covers React inline style props and the
# rotate-prompt inline styles; scripts need no inline allowance.

server {
    listen 443 ssl http2;
    server_name pavankhind.bobhata.com;

    # ssl_certificate     /etc/letsencrypt/live/pavankhind.bobhata.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/pavankhind.bobhata.com/privkey.pem;

    root /var/www/pavankhind.bobhata.com/current;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Hashed build assets are immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /fonts/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}

server {
    listen 80;
    server_name pavankhind.bobhata.com;
    return 301 https://$host$request_uri;
}
